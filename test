#property strict

//--- Input Parameters
input double InpLotSize      = 0.02;       // Lot Size per order
input int    InpMaxOrders    = 10;         // Maximum number of orders
input double InpTargetProfit = 5.0;        // Basket Take Profit (Account Currency)
input int    InpGridStep     = 500;        // Grid Step (in points)
input int    InpMagicNumber  = 888123;     // Magic Number
input int    InpSlippage     = 10;         // Slippage (in points)

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
  {
   double totalProfit = 0;
   int orderCount = 0;
   double lowestBuyPrice = 0;
   
   // 1. Calculate current basket profit and count open orders
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
        {
         // Filter for this symbol, magic number, and only Buy orders
         if(OrderSymbol() == Symbol() && OrderMagicNumber() == InpMagicNumber && OrderType() == OP_BUY)
           {
            // Include commission and swap in the net profit calculation
            totalProfit += (OrderProfit() + OrderSwap() + OrderCommission());
            orderCount++;
            
            // Find the lowest buy price (the most recent grid level added)
            if(lowestBuyPrice == 0 || OrderOpenPrice() < lowestBuyPrice)
              {
               lowestBuyPrice = OrderOpenPrice();
              }
           }
        }
     }

   // 2. Check if profit reached target ($5)
   if(orderCount > 0 && totalProfit >= InpTargetProfit)
     {
      CloseAllOrders();
      return; // Wait for the next tick to start a new grid
     }
     
   // 3. Open new orders
   if(orderCount == 0)
     {
      // Open initial order if no orders exist
      OpenBuyOrder();
     }
   else if(orderCount < InpMaxOrders)
     {
      // Check if price dropped enough to open the next grid level
      RefreshRates();
      if(Ask <= (lowestBuyPrice - (InpGridStep * Point)))
        {
         OpenBuyOrder();
        }
     }
  }

//+------------------------------------------------------------------+
//| Function to open a buy order                                     |
//+------------------------------------------------------------------+
void OpenBuyOrder()
  {
   RefreshRates();
   double ask = MarketInfo(Symbol(), MODE_ASK);
   int ticket = OrderSend(Symbol(), OP_BUY, InpLotSize, ask, InpSlippage, 0, 0, "HSI Long Grid", InpMagicNumber, 0, clrBlue);
   
   if(ticket < 0)
     {
      Print("Error opening BUY order: ", GetLastError());
     }
  }

//+------------------------------------------------------------------+
//| Function to close all grid orders                                |
//+------------------------------------------------------------------+
void CloseAllOrders()
  {
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
        {
         if(OrderSymbol() == Symbol() && OrderMagicNumber() == InpMagicNumber && OrderType() == OP_BUY)
           {
            RefreshRates();
            double bid = MarketInfo(Symbol(), MODE_BID);
            bool res = OrderClose(OrderTicket(), OrderLots(), bid, InpSlippage, clrRed);
            if(!res)
              {
               Print("Error closing order #", OrderTicket(), " : ", GetLastError());
              }
           }
        }
     }
  }
