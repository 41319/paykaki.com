#property strict

//--- Input Parameters (Initial Defaults)
input double InpLotSize             = 0.02;      // Initial Lot Size per order
input int    InpMaxOrders           = 10;        // Initial Maximum number of orders
input int    InpGridStep            = 500;       // Initial Grid Step (in points)
input double InpMinProfitActivate   = 2.0;       // Initial Min Profit ($) to start time-trail
input int    InpStagnationSeconds   = 300;       // Initial Time (seconds) without profit high
input int    InpMagicNumber         = 888124;    // Magic Number
input int    InpSlippage            = 10;        // Slippage (in points)

//--- Working Variables (Modifiable at runtime)
double g_LotSize;
int    g_MaxOrders;
int    g_GridStep;
double g_MinProfitActivate;
int    g_StagnationSeconds;
int    g_Slippage;

//--- Global Tracking Arrays
int      trackTickets[100];
double   trackMaxProfit[100];
datetime trackTimeMax[100];

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
  {
   // Initialize working variables with input defaults
   g_LotSize            = InpLotSize;
   g_MaxOrders          = InpMaxOrders;
   g_GridStep           = InpGridStep;
   g_MinProfitActivate  = InpMinProfitActivate;
   g_StagnationSeconds  = InpStagnationSeconds;
   g_Slippage           = InpSlippage;

   ArrayInitialize(trackTickets, 0);
   ArrayInitialize(trackMaxProfit, 0.0);
   ArrayInitialize(trackTimeMax, 0);
   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| Function to alter operational variables dynamically              |
//| Pass -1 (or -1.0) for any parameter you wish to keep unchanged   |
//+------------------------------------------------------------------+
void UpdateParameters(double newLotSize = -1.0, 
                      int newMaxOrders = -1, 
                      int newGridStep = -1, 
                      double newMinProfit = -1.0, 
                      int newStagnationSec = -1, 
                      int newSlippage = -1)
  {
   if(newLotSize > 0)          g_LotSize = newLotSize;
   if(newMaxOrders > 0)        g_MaxOrders = newMaxOrders;
   if(newGridStep > 0)         g_GridStep = newGridStep;
   if(newMinProfit >= 0)       g_MinProfitActivate = newMinProfit;
   if(newStagnationSec > 0)    g_StagnationSeconds = newStagnationSec;
   if(newSlippage >= 0)        g_Slippage = newSlippage;

   Print("Parameters updated: LotSize=", g_LotSize, 
         ", MaxOrders=", g_MaxOrders, 
         ", GridStep=", g_GridStep, 
         ", MinProfit=", g_MinProfitActivate, 
         ", StagnationSec=", g_StagnationSeconds, 
         ", Slippage=", g_Slippage);
  }

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
  {
   // 1. Remove closed orders from our tracking arrays
   CleanupTrackers();

   int orderCount = 0;
   double lowestBuyPrice = 0;

   // 2. Process open orders for Time-Based Trailing Profit & count grid
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
        {
         if(OrderSymbol() == Symbol() && OrderMagicNumber() == InpMagicNumber && OrderType() == OP_BUY)
           {
            orderCount++;
            
            // Find the lowest buy price for grid placement
            if(lowestBuyPrice == 0 || OrderOpenPrice() < lowestBuyPrice)
              {
               lowestBuyPrice = OrderOpenPrice();
              }
              
            // Check profit stagnation for this specific order
            ProcessOrderStagnation(OrderTicket());
           }
        }
     }

   // 3. Open new grid orders
   if(orderCount == 0)
     {
      OpenBuyOrder();
     }
   else if(orderCount < g_MaxOrders)
     {
      RefreshRates();
      if(Ask <= (lowestBuyPrice - (g_GridStep * Point)))
        {
         OpenBuyOrder();
        }
     }
  }

//+------------------------------------------------------------------+
//| Function to process profit stagnation per order                  |
//+------------------------------------------------------------------+
void ProcessOrderStagnation(int ticket)
  {
   if(!OrderSelect(ticket, SELECT_BY_TICKET)) return;

   double currentProfit = OrderProfit() + OrderSwap() + OrderCommission();
   bool found = false;

   for(int j = 0; j < 100; j++)
     {
      if(trackTickets[j] == ticket)
        {
         found = true;
         
         if(currentProfit > trackMaxProfit[j])
           {
            trackMaxProfit[j] = currentProfit;
            trackTimeMax[j] = TimeCurrent();
           }
         else
           {
            if(currentProfit >= g_MinProfitActivate)
              {
               if((TimeCurrent() - trackTimeMax[j]) >= g_StagnationSeconds)
                 {
                  Print("Order #", ticket, " closing due to profit stagnation. Profit: ", currentProfit);
                  CloseOrder(ticket);
                  trackTickets[j] = 0;
                 }
              }
           }
         break;
        }
     }

   if(!found)
     {
      for(int j = 0; j < 100; j++)
        {
         if(trackTickets[j] == 0)
           {
            trackTickets[j] = ticket;
            trackMaxProfit[j] = currentProfit;
            trackTimeMax[j] = TimeCurrent();
            break;
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| Function to cleanup closed orders from trackers                  |
//+------------------------------------------------------------------+
void CleanupTrackers()
  {
   for(int j = 0; j < 100; j++)
     {
      if(trackTickets[j] != 0)
        {
         if(!OrderSelect(trackTickets[j], SELECT_BY_TICKET))
           {
            trackTickets[j] = 0;
           }
         else if(OrderCloseTime() != 0)
           {
            trackTickets[j] = 0;
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| Function to open a buy order                                     |
//+------------------------------------------------------------------+
void OpenBuyOrder()
  {
   RefreshRates();
   double ask = MarketInfo(Symbol(), MODE_ASK);
   int ticket = OrderSend(Symbol(), OP_BUY, g_LotSize, ask, g_Slippage, 0, 0, "HSI Time Trail", InpMagicNumber, 0, clrBlue);
   
   if(ticket < 0)
     {
      Print("Error opening BUY order: ", GetLastError());
     }
  }

//+------------------------------------------------------------------+
//| Function to close a specific order                               |
//+------------------------------------------------------------------+
void CloseOrder(int ticket)
  {
   if(OrderSelect(ticket, SELECT_BY_TICKET))
     {
      RefreshRates();
      double bid = MarketInfo(Symbol(), MODE_BID);
      bool res = OrderClose(ticket, OrderLots(), bid, g_Slippage, clrRed);
      if(!res)
        {
         Print("Error closing order #", ticket, " : ", GetLastError());
        }
     }
  }
