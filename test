#property strict

//--- External Parameters
extern double InpLotSize             = 0.02;      // Lot Size per order
extern int    InpMaxOrders           = 10;        // Base Maximum orders
extern int    InpGridStep            = 500;       // Base Grid Step (in points)
extern double InpMinProfitActivate   = 2.0;       // Min Profit ($) to start time-trail
extern int    InpStagnationSeconds   = 300;       // Stagnation Time (seconds)
extern int    InpMagicNumber         = 888124;    // Magic Number
extern int    InpSlippage            = 10;        // Slippage (in points)

//--- Dynamic Margin Management Parameters
extern bool   InpUseDynamicMargin    = true;      // Enable margin-based adjustments
extern double InpMarginLevelHigh     = 800.0;     // Margin Level (%) threshold: Safe
extern double InpMarginLevelMid      = 400.0;     // Margin Level (%) threshold: Warning
extern double InpMarginLevelLow      = 200.0;     // Margin Level (%) threshold: Danger

//--- Global Tracking Arrays
int      trackTickets[100];
double   trackMaxProfit[100];
datetime trackTimeMax[100];

//+------------------------------------------------------------------+
//| Dynamic Margin Adaptation Function                               |
//+------------------------------------------------------------------+
void AdjustByMargin()
  {
   if(!InpUseDynamicMargin) return;

   // If no open trades exist yet, MarginLevel returns 0; keep base settings
   if(AccountMargin() == 0) return;

   double marginLevel = AccountInfoDouble(ACCOUNT_MARGIN_LEVEL);

   // Tier 1: High Margin (Safe Zone) -> Standard spacing and full order capacity
   if(marginLevel >= InpMarginLevelHigh)
     {
      InpGridStep  = 500;
      InpMaxOrders = 10;
     }
   // Tier 2: Medium Margin (Warning Zone) -> Widen grid by 50%, reduce order count
   else if(marginLevel >= InpMarginLevelMid && marginLevel < InpMarginLevelHigh)
     {
      InpGridStep  = 750;
      InpMaxOrders = 6;
     }
   // Tier 3: Low Margin (Caution Zone) -> Double grid distance, cap orders strictly
   else if(marginLevel >= InpMarginLevelLow && marginLevel < InpMarginLevelMid)
     {
      InpGridStep  = 1000;
      InpMaxOrders = 4;
     }
   // Tier 4: Critical Margin (Danger Zone) -> Ultra wide grid, prevent new orders
   else if(marginLevel < InpMarginLevelLow)
     {
      InpGridStep  = 1500;
      InpMaxOrders = 0; // Freezes new grid entries entirely
     }
  }

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
  {
   ArrayInitialize(trackTickets, 0);
   ArrayInitialize(trackMaxProfit, 0.0);
   ArrayInitialize(trackTimeMax, 0);
   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
  {
   // 1. Remove closed orders from our tracking arrays
   CleanupTrackers();

   // 2. Adjust Grid Step and Max Orders dynamically based on Margin Level
   AdjustByMargin();

   int orderCount = 0;
   double lowestBuyPrice = 0;

   // 3. Process open orders for Time-Based Trailing Profit & count grid
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
        {
         if(OrderSymbol() == Symbol() && OrderMagicNumber() == InpMagicNumber && OrderType() == OP_BUY)
           {
            orderCount++;
            
            // Find the lowest buy price for grid placement
            if(lowestBuyPrice == 0 || OrderOpenPrice() < lowestBuyPrice)
              {
               lowestBuyPrice = OrderOpenPrice();
              }
              
            // Check profit stagnation for this specific order
            ProcessOrderStagnation(OrderTicket());
           }
        }
     }

   // 4. Open new grid orders based on dynamically adjusted parameters
   if(orderCount == 0 && InpMaxOrders > 0)
     {
      OpenBuyOrder();
     }
   else if(orderCount < InpMaxOrders)
     {
      RefreshRates();
      if(Ask <= (lowestBuyPrice - (InpGridStep * Point)))
        {
         OpenBuyOrder();
        }
     }
  }

//+------------------------------------------------------------------+
//| Function to process profit stagnation per order                  |
//+------------------------------------------------------------------+
void ProcessOrderStagnation(int ticket)
  {
   if(!OrderSelect(ticket, SELECT_BY_TICKET)) return;

   double currentProfit = OrderProfit() + OrderSwap() + OrderCommission();
   bool found = false;

   for(int j = 0; j < 100; j++)
     {
      if(trackTickets[j] == ticket)
        {
         found = true;
         
         if(currentProfit > trackMaxProfit[j])
           {
            trackMaxProfit[j] = currentProfit;
            trackTimeMax[j] = TimeCurrent();
           }
         else
           {
            if(currentProfit >= InpMinProfitActivate)
              {
               if((TimeCurrent() - trackTimeMax[j]) >= InpStagnationSeconds)
                 {
                  Print("Order #", ticket, " closing due to profit stagnation. Profit: ", currentProfit);
                  CloseOrder(ticket);
                  trackTickets[j] = 0;
                 }
              }
           }
         break;
        }
     }

   if(!found)
     {
      for(int j = 0; j < 100; j++)
        {
         if(trackTickets[j] == 0)
           {
            trackTickets[j] = ticket;
            trackMaxProfit[j] = currentProfit;
            trackTimeMax[j] = TimeCurrent();
            break;
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| Function to cleanup closed orders from trackers                  |
//+------------------------------------------------------------------+
void CleanupTrackers()
  {
   for(int j = 0; j < 100; j++)
     {
      if(trackTickets[j] != 0)
        {
         if(!OrderSelect(trackTickets[j], SELECT_BY_TICKET))
           {
            trackTickets[j] = 0;
           }
         else if(OrderCloseTime() != 0)
           {
            trackTickets[j] = 0;
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| Function to open a buy order                                     |
//+------------------------------------------------------------------+
void OpenBuyOrder()
  {
   RefreshRates();
   double ask = MarketInfo(Symbol(), MODE_ASK);
   int ticket = OrderSend(Symbol(), OP_BUY, InpLotSize, ask, InpSlippage, 0, 0, "HSI Time Trail", InpMagicNumber, 0, clrBlue);
   
   if(ticket < 0)
     {
      Print("Error opening BUY order: ", GetLastError());
     }
  }

//+------------------------------------------------------------------+
//| Function to close a specific order                               |
//+------------------------------------------------------------------+
void CloseOrder(int ticket)
  {
   if(OrderSelect(ticket, SELECT_BY_TICKET))
     {
      RefreshRates();
      double bid = MarketInfo(Symbol(), MODE_BID);
      bool res = OrderClose(ticket, OrderLots(), bid, InpSlippage, clrRed);
      if(!res)
        {
         Print("Error closing order #", ticket, " : ", GetLastError());
        }
     }
  }
