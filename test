#property strict

//--- Input Parameters
input string InpFileName            = "grid_settings.txt"; // Config file in MQL4/Files/
input double InpDefaultLotSize      = 0.02;                // Fallback Lot Size per order
input int    InpDefaultMaxOrders    = 10;                  // Fallback Maximum number of orders
input int    InpDefaultGridStep     = 500;                 // Fallback Grid Step (in points)
input double InpDefaultMinProfitAct = 2.0;                  // Fallback Min Profit ($)
input int    InpDefaultStagnationSec= 300;                 // Fallback Stagnation Seconds
input int    InpDefaultMagicNumber  = 888124;              // Fallback Magic Number
input int    InpDefaultSlippage     = 10;                  // Fallback Slippage (in points)

//--- Working Variables (Loaded from file or default)
double LotSize;
int    MaxOrders;
int    GridStep;
double MinProfitActivate;
int    StagnationSeconds;
int    MagicNumber;
int    Slippage;

//--- Timer Tracking
datetime lastConfigReadTime = 0;
const int CONFIG_RELOAD_INTERVAL = 300; // 300 seconds = 5 minutes

//--- Global Tracking Arrays
int      trackTickets[100];
double   trackMaxProfit[100];
datetime trackTimeMax[100];

//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
  {
   ArrayInitialize(trackTickets, 0);
   ArrayInitialize(trackMaxProfit, 0.0);
   ArrayInitialize(trackTimeMax, 0);

   // Initial file read
   LoadSettingsFromFile(InpFileName);
   lastConfigReadTime = TimeCurrent();

   return(INIT_SUCCEEDED);
  }

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
  {
   // 0. Re-read config file every 5 minutes (300 seconds)
   if(TimeCurrent() - lastConfigReadTime >= CONFIG_RELOAD_INTERVAL)
     {
      LoadSettingsFromFile(InpFileName);
      lastConfigReadTime = TimeCurrent();
     }

   // 1. Remove closed orders from our tracking arrays
   CleanupTrackers();

   int orderCount = 0;
   double lowestBuyPrice = 0;

   // 2. Process open orders for Time-Based Trailing Profit & count grid
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
        {
         if(OrderSymbol() == Symbol() && OrderMagicNumber() == MagicNumber && OrderType() == OP_BUY)
           {
            orderCount++;
            
            // Find the lowest buy price for grid placement
            if(lowestBuyPrice == 0 || OrderOpenPrice() < lowestBuyPrice)
              {
               lowestBuyPrice = OrderOpenPrice();
              }
              
            // Check profit stagnation for this specific order
            ProcessOrderStagnation(OrderTicket());
           }
        }
     }

   // 3. Open new grid orders
   if(orderCount == 0)
     {
      OpenBuyOrder();
     }
   else if(orderCount < MaxOrders)
     {
      RefreshRates();
      if(Ask <= (lowestBuyPrice - (GridStep * Point)))
        {
         OpenBuyOrder();
        }
     }
  }

//+------------------------------------------------------------------+
//| Function to load key=value pairs from text file                  |
//+------------------------------------------------------------------+
void LoadSettingsFromFile(string filename)
  {
   // Set fallbacks first if not yet assigned
   if(LotSize == 0)
     {
      LotSize            = InpDefaultLotSize;
      MaxOrders          = InpDefaultMaxOrders;
      GridStep           = InpDefaultGridStep;
      MinProfitActivate  = InpDefaultMinProfitAct;
      StagnationSeconds  = InpDefaultStagnationSec;
      MagicNumber        = InpDefaultMagicNumber;
      Slippage           = InpDefaultSlippage;
     }

   int fileHandle = FileOpen(filename, FILE_READ | FILE_TXT);
   if(fileHandle == INVALID_HANDLE)
     {
      Print("Settings file '", filename, "' not found in MQL4/Files. Using current/default settings.");
      return;
     }

   while(!FileIsEnding(fileHandle))
     {
      string line = FileReadString(fileHandle);
      StringTrimLeft(line);
      StringTrimRight(line);

      // Skip comments or blank lines
      if(line == "" || StringSubstr(line, 0, 2) == "//" || StringSubstr(line, 0, 1) == "#")
         continue;

      int separatorPos = StringFind(line, "=");
      if(separatorPos > 0)
        {
         string key = StringSubstr(line, 0, separatorPos);
         string val = StringSubstr(line, separatorPos + 1);

         StringTrimLeft(key);
         StringTrimRight(key);
         StringTrimLeft(val);
         StringTrimRight(val);

         if(key == "LotSize")                 LotSize = StringToDouble(val);
         else if(key == "MaxOrders")          MaxOrders = (int)StringToInteger(val);
         else if(key == "GridStep")           GridStep = (int)StringToInteger(val);
         else if(key == "MinProfitActivate")  MinProfitActivate = StringToDouble(val);
         else if(key == "StagnationSeconds")  StagnationSeconds = (int)StringToInteger(val);
         else if(key == "MagicNumber")        MagicNumber = (int)StringToInteger(val);
         else if(key == "Slippage")           Slippage = (int)StringToInteger(val);
        }
     }

   FileClose(fileHandle);
   PrintFormat("Config reloaded (5m interval): LotSize=%.2f, MaxOrders=%d, GridStep=%d, MinProfit=%.2f, StagnationSec=%d, Magic=%d",
               LotSize, MaxOrders, GridStep, MinProfitActivate, StagnationSeconds, MagicNumber);
  }

//+------------------------------------------------------------------+
//| Function to process profit stagnation per order                  |
//+------------------------------------------------------------------+
void ProcessOrderStagnation(int ticket)
  {
   if(!OrderSelect(ticket, SELECT_BY_TICKET)) return;

   double currentProfit = OrderProfit() + OrderSwap() + OrderCommission();
   bool found = false;

   for(int j = 0; j < 100; j++)
     {
      if(trackTickets[j] == ticket)
        {
         found = true;
         
         if(currentProfit > trackMaxProfit[j])
           {
            trackMaxProfit[j] = currentProfit;
            trackTimeMax[j] = TimeCurrent();
           }
         else
           {
            if(currentProfit >= MinProfitActivate)
              {
               if((TimeCurrent() - trackTimeMax[j]) >= StagnationSeconds)
                 {
                  Print("Order #", ticket, " closing due to profit stagnation. Profit: ", currentProfit);
                  CloseOrder(ticket);
                  trackTickets[j] = 0;
                 }
              }
           }
         break;
        }
     }

   if(!found)
     {
      for(int j = 0; j < 100; j++)
        {
         if(trackTickets[j] == 0)
           {
            trackTickets[j] = ticket;
            trackMaxProfit[j] = currentProfit;
            trackTimeMax[j] = TimeCurrent();
            break;
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| Function to cleanup closed orders from trackers                  |
//+------------------------------------------------------------------+
void CleanupTrackers()
  {
   for(int j = 0; j < 100; j++)
     {
      if(trackTickets[j] != 0)
        {
         if(!OrderSelect(trackTickets[j], SELECT_BY_TICKET))
           {
            trackTickets[j] = 0;
           }
         else if(OrderCloseTime() != 0)
           {
            trackTickets[j] = 0;
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| Function to open a buy order                                     |
//+------------------------------------------------------------------+
void OpenBuyOrder()
  {
   RefreshRates();
   double ask = MarketInfo(Symbol(), MODE_ASK);
   int ticket = OrderSend(Symbol(), OP_BUY, LotSize, ask, Slippage, 0, 0, "HSI Time Trail", MagicNumber, 0, clrBlue);
   
   if(ticket < 0)
     {
      Print("Error opening BUY order: ", GetLastError());
     }
  }

//+------------------------------------------------------------------+
//| Function to close a specific order                               |
//+------------------------------------------------------------------+
void CloseOrder(int ticket)
  {
   if(OrderSelect(ticket, SELECT_BY_TICKET))
     {
      RefreshRates();
      double bid = MarketInfo(Symbol(), MODE_BID);
      bool res = OrderClose(ticket, OrderLots(), bid, Slippage, clrRed);
      if(!res)
        {
         Print("Error closing order #", ticket, " : ", GetLastError());
        }
     }
  }
